{
  "redirects": [
    {
      "source": "/:path((?!sw\\.js$).*)",
      "has": [
        {
          "type": "host",
          "value": "subcontractorpros.com"
        }
      ],
      "destination": "https://weesubby.com/:path",
      "permanent": true
    },
    {
      "source": "/:path((?!sw\\.js$).*)",
      "has": [
        {
          "type": "host",
          "value": "www.subcontractorpros.com"
        }
      ],
      "destination": "https://weesubby.com/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/hire",
      "destination": "/hire/index.html"
    },
    {
      "source": "/hire/:slug",
      "destination": "/hire/:slug/index.html"
    },
    {
      "source": "/:page(privacy|terms)",
      "destination": "/:page/index.html"
    },
    {
      "source": "/:page(post|pricing|reviews)",
      "destination": "/:page/index.html"
    },
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
